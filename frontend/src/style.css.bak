/* ==============================
   MUNITY OS — Design System v2
   ============================== */

:root {
  /* 品牌色 */
  --brand-primary: #1a73e8;
  --brand-primary-light: #4a9eff;
  --brand-primary-dark: #1557b0;
  
  /* 深色侧边栏 */
  --sidebar-bg: #1e293b;
  --sidebar-bg-hover: #334155;
  --sidebar-bg-active: #1a73e8;
  --sidebar-text: #94a3b8;
  --sidebar-text-active: #ffffff;
  --sidebar-width: 220px;
  
  /* 顶部栏 */
  --header-bg: #ffffff;
  --header-border: #e2e8f0;
  --header-height: 60px;
  
  /* 内容区 */
  --content-bg: #f1f5f9;
  --card-bg: #ffffff;
  --card-radius: 12px;
  --card-shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --card-shadow-hover: 0 4px 12px rgba(0,0,0,0.08);
  
  /* 字体 */
  --font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Arial, sans-serif;
  
  /* 间距 */
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;
  
  /* 圆角 */
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  
  /* 过渡 */
  --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-normal: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body, #app {
  height: 100%;
  width: 100%;
  overflow: hidden;
  font-family: var(--font-family);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background: var(--content-bg);
  color: #1e293b;
}

/* ========== Element Plus 覆盖 ========== */

/* Card — 全部用新样式覆盖 */
.el-card {
  border: none !important;
  border-radius: var(--card-radius) !important;
  box-shadow: var(--card-shadow) !important;
  transition: box-shadow var(--transition-normal) !important;
  margin-bottom: var(--spacing-lg) !important;
}
.el-card:hover {
  box-shadow: var(--card-shadow-hover) !important;
}
.el-card__header {
  padding: 18px 24px !important;
  border-bottom: 1px solid #f1f5f9 !important;
  font-weight: 600;
  font-size: 16px;
  color: #1e293b;
}
.el-card__body {
  padding: 24px !important;
}

/* Button */
.el-button {
  border-radius: var(--radius-sm) !important;
  font-weight: 500 !important;
  transition: all var(--transition-fast) !important;
}
.el-button--primary {
  --el-button-bg-color: var(--brand-primary);
  --el-button-border-color: var(--brand-primary);
  --el-button-hover-bg-color: var(--brand-primary-light);
  --el-button-hover-border-color: var(--brand-primary-light);
}

/* Input */
.el-input__wrapper {
  border-radius: var(--radius-sm) !important;
  box-shadow: 0 0 0 1px #e2e8f0 inset !important;
  transition: box-shadow var(--transition-fast) !important;
}
.el-input__wrapper.is-focus {
  box-shadow: 0 0 0 2px var(--brand-primary) inset !important;
}

/* Table */
.el-table {
  border-radius: var(--radius-sm) !important;
}
.el-table th {
  padding: 14px 0 !important;
  background: #f8fafc !important;
  color: #64748b !important;
  font-weight: 600 !important;
  font-size: 13px !important;
}
.el-table td {
  padding: 16px 0 !important;
}
.el-table--striped .el-table__body tr.el-table__row--striped td {
  background: #f8fafc !important;
}
.el-table__body tr:hover > td {
  background: #eef2ff !important;
}

/* Dialog */
.el-dialog {
  border-radius: var(--card-radius) !important;
  box-shadow: 0 20px 60px rgba(0,0,0,0.15) !important;
}
.el-dialog__header {
  padding: 20px 24px 0 !important;
}
.el-dialog__body {
  padding: 24px !important;
}
.el-dialog__footer {
  padding: 0 24px 20px !important;
}

/* Menu */
.el-menu {
  border-right: none !important;
}

/* Tabs */
.el-tabs__header {
  margin-bottom: 20px !important;
}
.el-tabs__item {
  padding: 0 20px !important;
  height: 44px !important;
  line-height: 44px !important;
  font-weight: 500 !important;
  transition: color var(--transition-fast) !important;
}
.el-tabs__active-bar {
  height: 3px !important;
  border-radius: 3px !important;
  background: var(--brand-primary) !important;
}

/* Tag */
.el-tag {
  border-radius: 4px !important;
  font-weight: 500 !important;
}

/* Divider */
.el-divider {
  margin: 12px 0 !important;
}

/* Empty */
.el-empty__description p {
  color: #94a3b8 !important;
}

/* Select dropdown */
.el-select-dropdown__item.selected {
  color: var(--brand-primary) !important;
  font-weight: 600 !important;
}

/* Notification */
.el-notification {
  border-radius: var(--radius-md) !important;
  border: none !important;
  box-shadow: 0 4px 20px rgba(0,0,0,0.12) !important;
}

/* Message */
.el-message {
  border-radius: var(--radius-sm) !important;
  border: none !important;
  min-width: 200px !important;
}

/* ========== 滚动条美化 ========== */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* ========== 通用动画 ========== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-16px); }
  to   { opacity: 1; transform: translateX(0); }
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.5; }
}

.animate-fade-in {
  animation: fadeIn 0.3s ease-out;
}
.animate-slide-in {
  animation: slideInLeft 0.3s ease-out;
}
.animate-slide-up {
  animation: slideUp 0.3s ease-out;
}

/* ========== 布局辅助 ========== */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}
.page-header h2 {
  font-size: 20px;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -0.01em;
}
.page-header p {
  font-size: 14px;
  color: #64748b;
  margin-top: 2px;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: var(--spacing-md);
}

.stat-card {
  background: var(--card-bg);
  border-radius: var(--card-radius);
  padding: 20px 24px;
  box-shadow: var(--card-shadow);
  transition: all var(--transition-normal);
  cursor: pointer;
}
.stat-card:hover {
  box-shadow: var(--card-shadow-hover);
  transform: translateY(-2px);
}
.stat-card .stat-value {
  font-size: 32px;
  font-weight: 700;
  color: var(--brand-primary);
  line-height: 1.2;
}
.stat-card .stat-label {
  font-size: 13px;
  color: #64748b;
  margin-top: 4px;
}
